{
  "name": "xml-carousel",
  "private": true,
  "version": "0.2.0",
  "description": "A local-first browser application for exploring DTD, XSD, and ZIP schema packages as navigable journeys.",
  "author": "Ben Wolfe",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjaminisawolfe/xml-carousel.git"
  },
  "bugs": {
    "url": "https://github.com/benjaminisawolfe/xml-carousel/issues"
  },
  "homepage": "https://xmlcarousel.wolfshafenpress.com/",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=./",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:relaxng-production": "vitest run src/standards/relaxng/adapter.test.ts src/standards/relaxng/productionValidator.test.ts src/standards/relaxng/workerProtocol.test.ts src/standards/relaxng/workerClient.test.ts",
    "test:rng-import": "vitest run src/standards/relaxng/productionValidator.test.ts src/schema/relaxng/standaloneRelaxNgProject.test.ts src/app/import/standaloneRelaxNgImport.test.ts src/tests/StandaloneRngImportIntegration.test.ts src/ui/layout/TopBarImport.test.ts",
    "test:rng-package": "vitest run src/app/import/schemaArchive/discoverSchemaArchive.test.ts src/app/import/schemaPackage/rngPackageResolution.test.ts src/workers/schemaImportWorkerRuntime.test.ts src/workers/schemaImportWorkerProtocol.test.ts src/app/import/schemaFileImportController.test.ts src/ui/layout/SchemaSetOutline.test.ts",
    "test:rng-model": "node scripts/generate-relax-ng-manual-qa-fixtures.mjs --verify && vitest run src/schema/relaxng/relaxNgSemanticModel.test.ts src/schema/relaxng/relaxNgPresentationProjector.test.ts src/schema/relaxng/relaxNgManualQaFixtures.test.ts src/schema/relaxng/standaloneRelaxNgProject.test.ts src/standards/relaxng/workerProtocol.test.ts src/app/import/standaloneRelaxNgImport.test.ts src/app/import/schemaPackage/rngPackageResolution.test.ts src/app/stores/relaxNgSemanticRetention.test.ts",
    "test:rnc": "node scripts/generate-relax-ng-rnc-manual-qa-fixtures.mjs --verify && vitest run src/schema/relaxng/relaxNgCompactSyntax.test.ts src/schema/relaxng/relaxNgCompactManualQaFixtures.test.ts src/standards/relaxng/productionValidator.test.ts src/app/import/standaloneRelaxNgImport.test.ts src/app/import/schemaArchive/discoverSchemaArchive.test.ts src/app/import/schemaPackage/rngPackageResolution.test.ts src/ui/layout/TopBarImport.test.ts",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "verify:dist": "node scripts/verify-static-build.mjs",
    "verify:xerces-runtime": "node scripts/verify-xerces-runtime.mjs",
    "verify:relaxng-runtime": "node scripts/verify-relaxng-runtime.mjs",
    "verify:release-integrity": "node scripts/verify-release-integrity.mjs",
    "fixtures:conformance:zip": "node scripts/generate-conformance-zip-fixtures.mjs",
    "fixtures:visualization:zip": "node scripts/generate-visualization-zip-fixtures.mjs",
    "audit:hermetic-foundry": "node scripts/audit-hermetic-foundry.mjs",
    "audit:hermetic-foundry:verify": "node scripts/audit-hermetic-foundry.mjs --expect tests/fixtures/hermetic-foundry/expected-audit.json --permutations",
    "visualization:coverage:matrix": "node scripts/generate-visualization-coverage-matrix.mjs",
    "audit:visualization-coverage": "node scripts/audit-visualization-coverage.mjs",
    "audit:visualization-coverage:verify": "node scripts/audit-visualization-coverage.mjs --matrix docs/technical/visualization-coverage-matrix.json --localization tests/fixtures/visualization-coverage/hermetic-finding-localization.json",
    "acceptance:complete-visualization": "node scripts/complete-visualization-acceptance.mjs",
    "relaxng:conformance:generate": "node scripts/generate-relax-ng-conformance-authority.mjs --write",
    "relaxng:oracle": "node scripts/regenerate-relax-ng-oracle.mjs",
    "relaxng:conformance": "node scripts/generate-relax-ng-conformance-authority.mjs && vitest run src/tests/RelaxNgConformanceGate.test.ts",
    "visualization:relaxng:matrix": "node scripts/generate-relax-ng-visualization-matrix.mjs",
    "acceptance:relaxng-complete-visualization": "node scripts/relax-ng-complete-visualization-acceptance.mjs && vitest run src/tests/RelaxNgCompleteVisualizationAcceptance.test.ts src/schema/relaxng/relaxNgPresentationProjector.test.ts",
    "audit:adversarial-import-boundary": "node scripts/audit-adversarial-import-boundary.mjs",
    "w3c:dtd:manifest": "node scripts/generate-w3c-dtd-manifest.mjs",
    "w3c:dtd:ci": "vitest run --config tools/xerces-wasm-spike/vitest.config.ts tools/xerces-wasm-spike/tests/w3c-dtd-conformance.spike.ts -t \"CI subset\"",
    "w3c:dtd:full": "vitest run --config tools/xerces-wasm-spike/vitest.config.ts tools/xerces-wasm-spike/tests/w3c-dtd-conformance.spike.ts -t \"full selected\"",
    "w3c:xsd:manifest": "node scripts/generate-w3c-xsd-manifest.mjs",
    "w3c:xsd:ci": "vitest run --config tools/xerces-wasm-spike/vitest.config.ts tools/xerces-wasm-spike/tests/w3c-xsd-manifest.spike.ts tools/xerces-wasm-spike/tests/w3c-xsd-conformance.spike.ts -t \"manifest integrity|committed CI subset\"",
    "w3c:xsd:full": "vitest run --config tools/xerces-wasm-spike/vitest.config.ts tools/xerces-wasm-spike/tests/w3c-xsd-conformance.spike.ts -t \"full bounded selection\"",
    "verify:hostile-mime": "node scripts/verify-hostile-mime-build.mjs",
    "vendor:xerces:publish-runtime": "pwsh -NoProfile -File tools/xerces-wasm-spike/scripts/publish-production-runtime.ps1",
    "vendor:relaxng:publish-runtime": "pwsh -NoProfile -File tools/relax-ng-wasm-spike/scripts/publish-production-runtime.ps1",
    "spike:relaxng:build-production": "pwsh -NoProfile -File tools/relax-ng-wasm-spike/scripts/build.ps1 -Production",
    "spike:relaxng:build-production-harness": "vite build --config tools/relax-ng-wasm-spike/production-harness.config.ts",
    "spike:relaxng:serve-production-harness": "node tools/relax-ng-wasm-spike/node/production-static-server.mjs",
    "spike:relaxng:test-production-firefox": "node tools/relax-ng-wasm-spike/node/run-production-firefox.mjs",
    "spike:xerces:bootstrap-source": "pwsh -NoProfile -File tools/xerces-wasm-spike/scripts/bootstrap-xerces.ps1",
    "spike:xerces:bootstrap-toolchain": "pwsh -NoProfile -File tools/xerces-wasm-spike/scripts/bootstrap-emsdk.ps1",
    "spike:xerces:bootstrap-build-tools": "pwsh -NoProfile -File tools/xerces-wasm-spike/scripts/bootstrap-build-tools.ps1",
    "spike:xerces:bootstrap-w3c": "pwsh -NoProfile -File tools/xerces-wasm-spike/scripts/bootstrap-w3c.ps1",
    "spike:xerces:bootstrap-w3c-xsd": "pwsh -NoProfile -File tools/xerces-wasm-spike/scripts/bootstrap-w3c-xsd.ps1",
    "spike:xerces:build": "pwsh -NoProfile -File tools/xerces-wasm-spike/scripts/build.ps1",
    "spike:xerces:test": "vitest run --config tools/xerces-wasm-spike/vitest.config.ts",
    "spike:xerces:build-harness": "vite build --config tools/xerces-wasm-spike/harness.config.ts",
    "spike:xerces:verify-harness": "node tools/xerces-wasm-spike/scripts/verify-harness.mjs",
    "spike:xerces:compare": "pwsh -NoProfile -File tools/xerces-wasm-spike/scripts/run-xerces-j-comparison.ps1",
    "spike:xerces:benchmark": "node tools/xerces-wasm-spike/scripts/benchmark.mjs",
    "spike:xerces:dev": "vite --config tools/xerces-wasm-spike/harness.config.ts",
    "spike:xerces:serve-harness": "node tools/xerces-wasm-spike/scripts/serve-harness.mjs",
    "validate": "node scripts/run-validation.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@eslint/js": "^9.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
