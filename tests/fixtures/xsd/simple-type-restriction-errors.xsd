<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="MissingBase">
    <xs:restriction>
      <xs:enumeration value="one"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MissingValue">
    <xs:restriction base="xs:string">
      <xs:enumeration/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MultipleRestrictions">
    <xs:restriction base="xs:string"/>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>
  <xs:simpleType name="ConflictingVarieties">
    <xs:restriction base="xs:string"/>
    <xs:list itemType="xs:string"/>
  </xs:simpleType>
</xs:schema>
