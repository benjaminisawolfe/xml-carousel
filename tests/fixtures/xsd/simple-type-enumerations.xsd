<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:t="urn:simple-types"
  targetNamespace="urn:simple-types"
  elementFormDefault="qualified">
  <xs:simpleType name="BaseToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="base"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="StatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="active"/>
      <xs:enumeration value="paused"/>
      <xs:enumeration value="active"/>
      <xs:enumeration value=""/>
      <xs:enumeration value="a-very-long-status-value-that-must-wrap-safely-in-the-inspector"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="IdentifierType">
    <xs:restriction base="t:BaseToken">
      <xs:enumeration value="alpha"/>
      <xs:enumeration value="beta"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="identifier" type="t:IdentifierType"/>
      </xs:sequence>
      <xs:attribute name="status" type="t:StatusType"/>
      <xs:attribute name="anonymousState">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="inner"/>
            <xs:enumeration value=""/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
</xs:schema>
