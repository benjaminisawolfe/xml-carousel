<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:v="urn:visualization" targetNamespace="urn:visualization">
  <xs:element name="head" type="xs:string"/>
  <xs:element name="member" substitutionGroup="v:head" type="xs:string"/>
  <xs:element name="before" type="xs:string"/>
  <xs:complexType name="Label">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="lang" type="xs:language"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:element name="after" type="xs:string"/>
  <xs:group name="contentGroup">
    <xs:sequence><xs:element name="member" type="xs:string"/></xs:sequence>
  </xs:group>
  <xs:simpleType name="Choice"><xs:union memberTypes="xs:string xs:token"/></xs:simpleType>
</xs:schema>
